# =========================================================
# SMART DEVELOPER PRODUCTIVITY — ENVIRONMENT CONFIGURATION
# (Use this template for deployment on Render, Vercel, or Docker)
# NEVER COMMIT ACTUAL SECRETS TO SOURCE CONTROL
# =========================================================

# Database Configuration (Aiven MySQL 8.4 / Local MySQL / PostgreSQL)
# Local MySQL: mysql+pymysql://root:password@localhost:3306/smart_developer_productivity
# Aiven MySQL 8.4: mysql+pymysql://avnadmin:<PASSWORD>@<AIVEN_HOST>:<PORT>/defaultdb
# Render Postgres: postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# (Optional) Aiven MySQL Custom CA Certificate
# Option 1: Paste Aiven Project CA text into DB_CA_CERT (supports multiline or \n):
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Option 2: Render Secret Files mounts ca.pem automatically at /etc/secrets/ca.pem (auto-detected)
# Option 3: Local or custom file path:
# DB_SSL_CA=/etc/secrets/ca.pem

# Connection Pool & Timeout Settings (Bounded to prevent cold-start hangs)
# DB_CONNECT_TIMEOUT=7
# DB_READ_TIMEOUT=10
# DB_WRITE_TIMEOUT=10
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=300

# JWT Authentication & Token-at-Rest Fernet Encryption
# IMPORTANT: Keep this constant across deployments to decrypt existing GitHub OAuth tokens
SECRET_KEY=<GENERATE_OR_PRESERVE_YOUR_SECRET_KEY>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GitHub OAuth Integration (Register at https://github.com/settings/developers)
GITHUB_CLIENT_ID=<YOUR_GITHUB_CLIENT_ID>
GITHUB_CLIENT_SECRET=<YOUR_GITHUB_CLIENT_SECRET>
# Production example: https://your-backend-api.onrender.com/github/callback
GITHUB_REDIRECT_URI=http://127.0.0.1:8001/github/callback
# Production example: https://your-frontend-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Allowed CORS Origins (Comma-separated for multiple domains)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-app.vercel.app

# Frontend Environment Variables (Set in Vercel or frontend/.env)
# VITE_API_BASE_URL=https://your-backend-api.onrender.com
# VITE_API_URL=https://your-backend-api.onrender.com
