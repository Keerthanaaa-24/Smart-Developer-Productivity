# =========================================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================

# Database Configuration (PostgreSQL / MySQL 8.0+)
# PostgreSQL example: postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
# MySQL example: mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# JWT Authentication & Token-at-Rest Fernet Encryption
SECRET_KEY=<GENERATE_A_SECURE_RANDOM_SECRET_KEY>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GitHub OAuth Integration (Register at https://github.com/settings/developers)
GITHUB_CLIENT_ID=<YOUR_GITHUB_CLIENT_ID>
GITHUB_CLIENT_SECRET=<YOUR_GITHUB_CLIENT_SECRET>
# Production example: https://your-backend-api.onrender.com/github/callback
GITHUB_REDIRECT_URI=http://127.0.0.1:8001/github/callback
# Production example: https://your-frontend-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Allowed CORS Origins (Comma-separated for multiple domains)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-app.vercel.app
