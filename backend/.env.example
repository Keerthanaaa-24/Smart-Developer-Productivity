# =========================================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================

# Database Configuration (Aiven MySQL 8.4 / MySQL / PostgreSQL)
# Local MySQL: mysql+pymysql://root:password@localhost:3306/smart_developer_productivity
# Aiven MySQL 8.4: mysql+pymysql://avnadmin:<PASSWORD>@<AIVEN_HOST>:<PORT>/defaultdb
# Render / Heroku Postgres: postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# (Optional) Aiven MySQL SSL Configuration (if using custom CA cert)
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DB_SSL_NO_VERIFY=false

# Connection Pool Settings (Defaults: size=10, max_overflow=20, recycle=1800s)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800

# JWT Authentication & Token-at-Rest Fernet Encryption
# IMPORTANT: Keep this constant across deployments to decrypt existing GitHub OAuth tokens
SECRET_KEY=<GENERATE_OR_PRESERVE_YOUR_SECRET_KEY>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# GitHub OAuth Integration (Register at https://github.com/settings/developers)
GITHUB_CLIENT_ID=<YOUR_GITHUB_CLIENT_ID>
GITHUB_CLIENT_SECRET=<YOUR_GITHUB_CLIENT_SECRET>
# Production Render example: https://smart-developer-productivity-backend.onrender.com/github/callback
# Local development example: http://127.0.0.1:8001/github/callback
GITHUB_REDIRECT_URI=http://127.0.0.1:8001/github/callback
# Production Vercel example: https://your-frontend-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Allowed CORS Origins (Comma-separated for multiple domains)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-app.vercel.app
